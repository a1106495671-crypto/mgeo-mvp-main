DEEPSEEK_MOBILE_API_KEY=
DEEPSEEK_MOBILE_BASE_URL=
DEEPSEEK_MOBILE_MODEL=

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

DOUBAO_API_KEY=
# 火山方舟默认地址；DOUBAO_MODEL 建议填写可调用的 endpoint id 或模型名
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
# 可选：豆包手机版单独配置；不填则复用 DOUBAO_*
DOUBAO_MOBILE_API_KEY=
DOUBAO_MOBILE_BASE_URL=
DOUBAO_MOBILE_MODEL=

QIANWEN_API_KEY=
QIANWEN_BASE_URL=
QIANWEN_MODEL=

YUANBAO_API_KEY=
YUANBAO_BASE_URL=
YUANBAO_MODEL=

WENXIN_API_KEY=
# 百度千帆默认地址；WENXIN_MODEL 请填写实际可用模型名
WENXIN_BASE_URL=https://qianfan.baidubce.com/v2
WENXIN_MODEL=

DATABASE_URL=
PGSSL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret
CRON_SECRET=replace_with_a_cron_secret
# 交付中心同步地址：前台检测完成后会把每个平台的观测结果同步到这里。
# 本地开发建议交付中心单独跑 3001，避免和前台 localhost:3000 冲突。
MGEO_DELIVERY_API_BASE_URL=http://127.0.0.1:3001
MGEO_DELIVERY_USER_ID=demo-user
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_BASIC_VARIANT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_BASIC_CHECKOUT_URL=
LEMONSQUEEZY_PRO_CHECKOUT_URL=

# Optional
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

